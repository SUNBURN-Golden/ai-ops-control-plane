#!/bin/bash
# ASTRA GROK_BUILD builder wrapper (root-owned, invoked by astra-host-control as the
# astra-control identity). Reads the launch packet as control identity, then
# drops to the builder identity for all provider work. ASTRA_HOST_INFLIGHT_FD
# stays open in this wrapper while the send is in flight; sudo strips it from
# the builder process environment and descriptor table.
set -euo pipefail
INNER=/opt/astra/libexec/astra-grok-adapter
case "${1:-}" in
  --preflight)
    exec /usr/bin/sudo -n -u astra-builder-grokbuild -- "$INNER" --preflight
    ;;
  *)
    packet="${1:?launch packet path required}"
    exec /usr/bin/sudo -n -u astra-builder-grokbuild -- "$INNER" --launch < "$packet"
    ;;
esac
