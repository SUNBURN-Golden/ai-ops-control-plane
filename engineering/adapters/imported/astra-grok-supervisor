#!/usr/bin/python3 -I
"""ASTRA GROK_BUILD persistent supervisor — launch contract v2.

Official headless surface (docs.x.ai headless-scripting):
  grok --no-auto-update --prompt-file PATH -s UUID --output-format json
       --always-approve --cwd WORKTREE
Auto-update also disabled via ~/.grok/config.toml [cli] auto_update=false.
Resume (at most one): grok --no-auto-update -r UUID ...

Session durability requires this supervisor process to remain alive after
CONFIRMED; a session directory on disk alone is not sufficient evidence.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import pwd
import re
import signal
import subprocess
import sys
import time
from urllib.parse import quote

GROK_BIN = "/opt/astra/libexec/grok"
MAX_RESUMES = 1
DISCOVER_DEADLINE = 120.0
POST_EXIT_GRACE = 8.0
POLL_INTERVAL = 1.5
RESUME_PROMPT = ("The previous Grok CLI run exited abnormally before the "
                 "assigned task was completed. Resume work on the same "
                 "approved task scope and report evidence.")
SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")


def builder_home():
    return pwd.getpwuid(os.getuid()).pw_dir


def child_env():
    home = builder_home()
    return {"HOME": home,
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "LANG": "C.UTF-8",
            "GROK_HOME": str(Path(home) / ".grok")}


def atomic_write(path, payload):
    tmp = path.with_name(path.name + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, json.dumps(payload, sort_keys=True).encode())
    finally:
        os.close(fd)
    os.rename(tmp, path)


def write_status(session_dir, state, **extra):
    payload = {"state": state, "supervisor_pid": os.getpid(),
               "supervisor_sid": os.getsid(0), "at": time.time()}
    payload.update(extra)
    atomic_write(session_dir / "status.json", payload)


def grok_session_path(worktree, cli_uuid):
    key = quote(str(worktree), safe="")
    return Path(builder_home()) / ".grok" / "sessions" / key / cli_uuid


def session_registered(worktree, cli_uuid):
    """True when the named session has durable on-disk content under GROK_HOME."""
    path = grok_session_path(worktree, cli_uuid)
    if not path.is_dir():
        return False
    for name in ("chat_history.jsonl", "summary.json", "events.jsonl", "usage.json"):
        if (path / name).is_file():
            return True
    return False


def cli_argv(prompt_file, worktree, cli_uuid, resume=False):
    argv = [GROK_BIN, "--no-auto-update",
            "--output-format", "json",
            "--always-approve",
            "--cwd", str(worktree)]
    if resume:
        argv += ["-r", cli_uuid, "-p", RESUME_PROMPT]
    else:
        argv += ["--prompt-file", str(prompt_file), "-s", cli_uuid]
    return argv


def supervise(job):
    worktree = Path(job["worktree"])
    session_dir = Path(job["session_dir"])
    prompt_file = job["prompt_file"]
    request = job["launch_request_id"]
    cli_uuid = job["cli_session_uuid"]
    if not UUID_RE.match(cli_uuid):
        atomic_write(session_dir / "result.json", {
            "outcome": "FAILED_PRESTART", "session_id": None,
            "reason": "invalid cli_session_uuid"})
        return 0

    out_log = open(session_dir / "cli.out.log", "ab", buffering=0)
    err_log = open(session_dir / "cli.err.log", "ab", buffering=0)
    child = {"proc": None}

    def on_term(_signo, _frame):
        write_status(session_dir, "KILLED", reason="SIGTERM to supervisor")
        if child["proc"] is not None and child["proc"].poll() is None:
            child["proc"].terminate()
        os._exit(143)

    signal.signal(signal.SIGTERM, on_term)

    try:
        child["proc"] = subprocess.Popen(
            cli_argv(prompt_file, worktree, cli_uuid),
            cwd=str(worktree), env=child_env(),
            stdin=subprocess.DEVNULL, stdout=out_log, stderr=err_log)
    except OSError as exc:
        write_status(session_dir, "SPAWN_FAILED", reason=str(exc))
        atomic_write(session_dir / "result.json", {
            "outcome": "FAILED_PRESTART", "session_id": None,
            "reason": f"grok CLI failed to start: {exc}"})
        return 0

    write_status(session_dir, "RUNNING", cli_pid=child["proc"].pid,
                 worktree=str(worktree), cli_session_uuid=cli_uuid)

    session_id = None
    result_written = False
    deadline = time.monotonic() + DISCOVER_DEADLINE
    resumes = 0

    def record_session():
        nonlocal session_id, result_written
        session_id = f"grok-cli:{cli_uuid}"
        atomic_write(session_dir / "session.json", {
            "session_id": session_id, "cli_session_id": cli_uuid,
            "launch_request_id": request, "worktree": str(worktree),
            "supervisor_pid": os.getpid(),
            "cli_pid": child["proc"].pid, "resumed": resumes > 0,
            "at": time.time()})
        if not result_written:
            # CONFIRMED only while supervisor+CLI are alive (durable process).
            if child["proc"].poll() is not None:
                return False
            atomic_write(session_dir / "result.json",
                         {"outcome": "CONFIRMED", "session_id": session_id})
            result_written = True
        return True

    while True:
        if session_id is None and session_registered(worktree, cli_uuid):
            if not record_session():
                write_status(session_dir, "EXITED",
                             reason="session appeared after CLI exit")
                atomic_write(session_dir / "result.json", {
                    "outcome": "FAILED_PRESTART", "session_id": None,
                    "reason": "grok session registered only after CLI exit; "
                              "not treated as durable"})
                return 0
            write_status(session_dir, "RUNNING",
                         cli_pid=child["proc"].pid,
                         session_id=session_id, worktree=str(worktree))
        rc = child["proc"].poll()
        if rc is not None:
            if session_id is None:
                grace_end = time.monotonic() + POST_EXIT_GRACE
                while time.monotonic() < grace_end and session_id is None:
                    time.sleep(1.0)
                    if session_registered(worktree, cli_uuid):
                        # Still not durable: CLI already gone.
                        break
                write_status(session_dir, "EXITED", exit_code=rc,
                             cli_pid=child["proc"].pid)
                atomic_write(session_dir / "result.json", {
                    "outcome": "FAILED_PRESTART", "session_id": None,
                    "reason": f"grok CLI exited {rc} before a durable "
                              "supervised session was confirmed"})
                return 0
            elif rc != 0 and resumes < MAX_RESUMES:
                resumes += 1
                write_status(session_dir, "RESUMING", exit_code=rc,
                             attempt=resumes, session_id=session_id)
                try:
                    child["proc"] = subprocess.Popen(
                        cli_argv(prompt_file, worktree, cli_uuid, resume=True),
                        cwd=str(worktree), env=child_env(),
                        stdin=subprocess.DEVNULL,
                        stdout=out_log, stderr=err_log)
                except OSError:
                    write_status(session_dir, "EXITED", exit_code=rc,
                                 session_id=session_id,
                                 resume_error="respawn failed")
                    return 0
                continue
            write_status(session_dir, "EXITED", exit_code=rc,
                         session_id=session_id, cli_pid=child["proc"].pid,
                         resumes=resumes)
            return 0
        if session_id is None and time.monotonic() > deadline \
                and not result_written:
            atomic_write(session_dir / "result.json", {
                "outcome": "UNKNOWN", "session_id": None,
                "reason": "grok CLI running but no durable session id "
                          "observed within deadline"})
            result_written = True
            write_status(session_dir, "RUNNING_UNIDENTIFIED",
                         cli_pid=child["proc"].pid, worktree=str(worktree))
        time.sleep(POLL_INTERVAL if session_id is None else 15.0)
        if session_id is not None:
            write_status(session_dir, "RUNNING", cli_pid=child["proc"].pid,
                         session_id=session_id, worktree=str(worktree),
                         resumes=resumes)


def main(argv):
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    if len(argv) != 1:
        print("usage: astra-grok-supervisor <job.json>", file=sys.stderr)
        return 2
    try:
        job = json.loads(Path(argv[0]).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 2
    required = {"launch_request_id", "worktree", "session_dir",
                "prompt_file", "cli_session_uuid"}
    if not isinstance(job, dict) or not required <= set(job) \
            or not SAFE_ID.match(str(job.get("launch_request_id", ""))):
        return 2
    try:
        return supervise(job)
    except Exception as exc:
        try:
            write_status(Path(job["session_dir"]), "SUPERVISOR_ERROR",
                         reason=f"{type(exc).__name__}: {exc}")
        except Exception:
            pass
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
