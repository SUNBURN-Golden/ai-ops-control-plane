#!/usr/bin/python3 -I
"""Root-protected audit-host recovery entrypoint; no new sudo grant."""
import os
import sys
import stat
import types
import hashlib
import json
from pathlib import Path
path = '/opt/aiops/lib/control_plane_recover.py'
try:
    for parent in ('/', '/opt', '/opt/aiops', '/opt/aiops/lib'):
        s = os.lstat(parent)
        if not stat.S_ISDIR(s.st_mode) or s.st_uid != 0 or s.st_mode & 0o022:
            raise ValueError()
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, 'rb') as f:
        s = os.fstat(f.fileno())
        if not stat.S_ISREG(s.st_mode) or s.st_uid != 0 or s.st_nlink != 1 or s.st_mode & 0o022:
            raise ValueError()
        raw = f.read(1 << 20)
    def trusted_read(name, mode=None):
        for parent in Path(name).parents:
            st = os.lstat(parent)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
                raise ValueError()
        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(descriptor, 'rb') as stream:
            st = os.fstat(stream.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or st.st_mode & 0o022 or (mode is not None and stat.S_IMODE(st.st_mode) != mode):
                raise ValueError()
            return stream.read(1 << 20)
    cfg = json.loads(trusted_read('/etc/aiops/recovery.json', 0o600))
    manifest_bytes = trusted_read('/etc/aiops/recovery-manifest.json')
    if hashlib.sha256(manifest_bytes).hexdigest() != cfg['manifest_sha256']:
        raise ValueError()
    manifest = json.loads(manifest_bytes)
    entry = next(x for x in manifest['files'] if x['destination'] == path)
    if hashlib.sha256(raw).hexdigest() != entry['sha256']:
        raise ValueError()
    sys.path.insert(0, '/opt/aiops/lib/python')
    module = types.ModuleType('control_plane_recover')
    module.__file__ = path
    sys.modules[module.__name__] = module
    exec(compile(raw, path, 'exec'), module.__dict__)
    sys.exit(module.recover_main())
except (OSError, ValueError, KeyError, StopIteration):
    print('{"status":"HOLD","reason":"INSTALLATION_DRIFT"}')
    sys.exit(1)
