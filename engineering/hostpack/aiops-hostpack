#!/usr/bin/python3 -I
"""aiops-hostpack launcher: runs the installed pack module only when its whole path is root-protected."""
import os
import stat
import sys

MODULE = '/opt/aiops/lib/control_plane_hostpack.py'
try:
    for parent in ('/', '/opt', '/opt/aiops', '/opt/aiops/lib'):
        info = os.lstat(parent)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError()
    descriptor = os.open(MODULE, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(descriptor, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o022:
            raise ValueError()
        source = stream.read(1 << 20)
except (OSError, ValueError):
    print('{"reason": "INSTALLATION_DRIFT", "status": "HOLD"}')
    raise SystemExit(1)
sys.path[:0] = ['/opt/aiops/lib/python', '/opt/aiops/lib']
namespace = {'__name__': '__main__', '__file__': MODULE}
exec(compile(source, MODULE, 'exec'), namespace)
